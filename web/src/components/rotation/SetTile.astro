---
import type { Locale } from '../../config/site';
import { withBase } from '../../lib/links';
import type { TileData } from '../../lib/tiles';

interface Props {
  tile: TileData;
  locale: Locale;
}

const { tile } = Astro.props;
---

<a class="tile" href={tile.href} data-tilt data-set-link={tile.code}>
  <div class="art">
    {tile.packImage ? (
      <img
        src={withBase(tile.packImage)}
        alt=""
        width="300"
        height="540"
        loading="lazy"
        decoding="async"
      />
    ) : (
      tile.iconUrl && <img class="icon" src={tile.iconUrl} alt="" width="64" height="64" />
    )}
  </div>
  <span class="name">{tile.name}</span>
  <span class="sub mono">
    {tile.subline}
    {tile.note && <span class="note">{tile.note}</span>}
  </span>
</a>

<style>
  .tile {
    --rx: 0deg;
    --ry: 0deg;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 6px;
    padding: 18px var(--tile-pad-x, 12px) 16px;
    border-radius: var(--radius-lg);
    text-decoration: none;
    text-align: center;
    transition: background 0.2s;
  }

  .tile:hover,
  .tile:focus-visible {
    background: radial-gradient(closest-side, rgb(242 193 78 / 0.07), transparent);
  }

  .art {
    height: var(--tile-art-height, 220px);
    display: grid;
    place-items: end center;
    perspective: 700px;
  }

  .art img {
    max-height: var(--tile-art-height, 220px);
    width: auto;
    filter: drop-shadow(0 18px 22px rgb(0 0 0 / 0.55));
    transform: rotateX(var(--rx)) rotateY(var(--ry));
    transition:
      transform 0.25s var(--ease-out),
      filter 0.25s;
  }

  .tile:hover .art img {
    transform: rotateX(var(--rx)) rotateY(var(--ry)) translateY(-8px) scale(1.04);
    filter: drop-shadow(0 26px 26px rgb(0 0 0 / 0.6));
  }

  .art .icon {
    width: 64px;
    height: 64px;
    margin-bottom: 30%;
    filter: invert(1) opacity(0.7);
  }

  .name {
    margin-top: 10px;
    font-weight: 600;
    font-size: 14px;
    line-height: 1.3;
  }

  .sub {
    font-size: 11.5px;
    color: var(--text-faint);
  }

  .note {
    margin-left: 6px;
    color: var(--hot);
  }

  @media (max-width: 560px) {
    .tile {
      --tile-art-height: 170px;
    }
  }
</style>
