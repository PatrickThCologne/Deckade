---
import { type Locale, SITE_NAME, SITE_NAME_PARTS } from '../../config/site';
import { localePath } from '../../lib/links';
import InfoMenu from './InfoMenu.astro';
import LanguageSwitcher from './LanguageSwitcher.astro';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const [deck, gold] = SITE_NAME_PARTS;
---

<header class="site-header">
  <div class="container bar">
    <a class="brand" href={localePath(locale)} aria-label={SITE_NAME}>
      <span class="name">
        {deck}
        <span class="gem" aria-hidden="true"></span>
        <span class="accent">{gold}</span>
      </span>
    </a>
    <div class="menus">
      <InfoMenu locale={locale} />
      <LanguageSwitcher locale={locale} />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 20;
    background: rgb(6 8 12 / 0.72);
    backdrop-filter: blur(16px) saturate(140%);
    border-bottom: 1px solid var(--line);
  }

  .bar {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    height: 68px;
  }

  .menus {
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    gap: 11px;
    text-decoration: none;
  }

  .name {
    font-family: var(--font-display), sans-serif;
    font-weight: var(--font-display-weight);
    font-size: 30px;
    letter-spacing: 0.01em;
  }

  @media (max-width: 480px) {
    .name {
      font-size: 25px;
    }
  }

  .accent {
    color: var(--accent);
  }

  /* A small gold gem between the two halves: a frame with a filled core */
  .gem {
    position: relative;
    display: inline-block;
    width: 10px;
    height: 10px;
    margin: 0 6px 4px;
    border: 1.5px solid var(--accent);
    transform: rotate(45deg);
  }

  .gem::after {
    content: '';
    position: absolute;
    inset: 1.5px;
    background: var(--accent);
  }
</style>
