---
import { LOCALE_TAGS, type Locale, SITE_NAME } from '../../config/site';
import { creditedArtists } from '../../lib/backdrop';
import { snapshot } from '../../lib/data/load';
import { createFormatters } from '../../lib/format';
import { useTranslations } from '../../lib/i18n';
import { localePath } from '../../lib/links';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const { t } = useTranslations(locale);
const format = createFormatters(locale);
const updated = format.date(snapshot.generatedAt.slice(0, 10));
// Scryfall asks to name the artist wherever an art crop is shown, so the list stays visible.
const artists = creditedArtists(
  snapshot.featuredArt.map((art) => art.artist),
  LOCALE_TAGS[locale],
);
const links = [
  { href: localePath(locale, 'about'), label: t('nav.method') },
  { href: localePath(locale, 'imprint'), label: t('nav.imprint') },
  { href: localePath(locale, 'privacy'), label: t('nav.privacy') },
];
---

<footer class="site-footer">
  <div class="inner container">
    <div class="top">
      <p class="data">{t('footer.data', { date: updated })}</p>
      <nav aria-label={t('nav.info')}>
        {links.map((link) => (
          <a href={link.href}>{link.label}</a>
        ))}
      </nav>
    </div>
    <div class="legal">
      <p>
        {SITE_NAME} is unofficial Fan Content permitted under the{' '}
        <a href="https://company.wizards.com/en/legal/fancontentpolicy" rel="noopener">
          Fan Content Policy.
        </a>{' '}
        Not approved/endorsed by Wizards. Portions of the materials used are property of Wizards of
        the Coast. ©Wizards of the Coast LLC.
      </p>
      {artists.length > 0 && (
        <details class="credits">
          <summary>{t('footer.art', { count: String(artists.length) })}</summary>
          <p>{artists.join(', ')}.</p>
        </details>
      )}
    </div>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--line);
    background: rgb(6 8 12 / 0.6);
  }

  /* Two quiet lines, as wide as the panels above (the background runs over the whole window):
     the data source with the links, then the Fan Content notice Wizards asks for, word for
     word. The artists of the background (Scryfall asks to name them where their art crops are
     shown) are one click away. */
  .inner {
    display: grid;
    gap: 4px;
    padding-block: 12px 14px;
    font-size: 10.5px;
    line-height: 1.6;
    color: color-mix(in srgb, var(--text-faint) 60%, var(--bg));
  }

  p {
    margin: 0;
  }

  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 4px 24px;
  }

  .data {
    color: color-mix(in srgb, var(--text-dim) 30%, var(--text-faint));
  }

  nav {
    display: flex;
    gap: 14px;
  }

  .legal {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 2px 16px;
  }

  .credits[open] {
    flex-basis: 100%;
  }

  summary {
    color: color-mix(in srgb, var(--text-dim) 30%, var(--text-faint));
    cursor: pointer;
  }

  summary:hover {
    color: var(--accent);
  }

  a {
    color: color-mix(in srgb, var(--text-dim) 30%, var(--text-faint));
    text-decoration: none;
  }

  .legal a {
    text-decoration: underline;
    text-underline-offset: 2px;
  }

  a:hover {
    color: var(--accent);
  }
</style>
