---
/**
 * The page tabs. They stand on the top edge of the banner like folder tabs, leaning at the
 * same angle as the banner's edge (--lean). On hover the light along the banner's top edge
 * glides over under the tab (scripts/tab-light.ts), and a thin gold line runs up the tab's
 * left edge, round the corner and settles along its top.
 */
import type { Locale } from '../../config/site';
import { useTranslations } from '../../lib/i18n';
import { localePath } from '../../lib/links';

export type Tab = 'overview' | 'cards' | 'rotation' | 'search';

interface Props {
  current: Tab;
  locale: Locale;
}

const { current, locale } = Astro.props;
const { t } = useTranslations(locale);
const tabs = [
  {
    id: 'overview',
    href: localePath(locale),
    label: t('tabs.overview'),
    short: t('tabs.overview.short'),
  },
  {
    id: 'cards',
    href: localePath(locale, 'cards'),
    label: t('tabs.cards'),
    short: t('tabs.cards.short'),
  },
  {
    id: 'rotation',
    href: localePath(locale, 'rotation'),
    label: t('tabs.rotation'),
    short: t('tabs.rotation.short'),
  },
  {
    id: 'search',
    href: localePath(locale, 'search'),
    label: t('tabs.search'),
    short: t('tabs.search.short'),
  },
] as const; // short: the label on narrow screens
---

<nav class="tabs" aria-label={t('tabs.label')} data-tabs>
  {tabs.map((tab) => (
    <a class="tab" href={tab.href} aria-current={tab.id === current ? 'page' : undefined}>
      <span>
        <span class="long">{tab.label}</span>
        <span class="short">{tab.short}</span>
      </span>
    </a>
  ))}
</nav>

<script>
  import { initTabLight } from '../../scripts/tab-light';

  initTabLight();
</script>

<style>
  .tabs {
    /* The tabs' offsets are measured from here (scripts/tab-light.ts) */
    position: relative;
    display: flex;
    gap: 3px;
  }

  .tab {
    --tab-bg: rgb(10 11 15 / 0.82);
    /* How far the top edge leans to the right; the shape below stays inside the tab */
    --lean-x: 10px;
    position: relative;
    isolation: isolate;
    flex: none;
    padding: 9px calc(var(--lean-x) + 16px) 8px;
    color: var(--text-dim);
    text-decoration: none;
    font-family: var(--font-display), sans-serif;
    font-size: 14.5px;
    font-weight: var(--font-display-weight);
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: color 0.15s;
  }

  /* The shape: a parallelogram standing on the banner's edge */
  .tab::before {
    content: '';
    position: absolute;
    inset: 0 var(--lean-x) 0 0;
    transform: skewX(var(--lean));
    transform-origin: bottom left;
    background: var(--tab-bg);
    transition: background 0.2s;
  }

  .tab > span {
    position: relative;
    z-index: 1;
  }

  .short {
    display: none;
  }

  .tab:hover,
  .tab:focus-visible {
    --tab-bg: rgb(30 33 42 / 0.94);
    color: var(--text);
  }

  /* The gold line on hover, a little inside the tab's edge and leaning with it. Two layers: the
     upright part grows from the tab's foot up the left side, then the top part runs from the
     corner to about the middle. Both fade out away from the corner, the upright one by half
     the tab's height, like the light under the tabs. The upright part ends a pixel below the
     corner, so the two do not cover the corner pixel twice. They stay while the pointer rests
     and fade out when it leaves. */
  .tab:not([aria-current])::after {
    --trace: rgb(242 193 78 / 0.75);
    --trace-length: 55%;
    content: '';
    position: absolute;
    inset: 5px calc(var(--lean-x) + 7px) 0 7px;
    transform: skewX(var(--lean));
    transform-origin: bottom left;
    background:
      linear-gradient(var(--trace) 15%, transparent 60%) 0 100% / 1px calc(100% - 1px) no-repeat,
      linear-gradient(90deg, var(--trace) 35%, transparent) 0 0 / var(--trace-length) 1px no-repeat;
    opacity: 0;
    transition: opacity 0.25s;
    pointer-events: none;
  }

  .tab:not([aria-current]):is(:hover, :focus-visible)::after {
    opacity: 1;
    transition: none;
    animation: tab-trace 0.5s cubic-bezier(0.4, 0, 1, 1) both;
  }

  @keyframes tab-trace {
    0% {
      background-size:
        1px 0,
        0 1px;
    }
    40% {
      background-size:
        1px calc(100% - 1px),
        0 1px;
      animation-timing-function: cubic-bezier(0.22, 0.9, 0.24, 1);
    }
    100% {
      background-size:
        1px calc(100% - 1px),
        var(--trace-length) 1px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab:not([aria-current]):is(:hover, :focus-visible)::after {
      animation: none;
    }
  }

  .tab[aria-current='page'] {
    --tab-bg: var(--accent);
    color: #04110c;
  }

  @media (max-width: 480px) {
    .tab {
      --lean-x: 8px;
      padding-inline: calc(var(--lean-x) + 9px);
      font-size: 13px;
    }

    .long {
      display: none;
    }

    .short {
      display: inline;
    }
  }
</style>
