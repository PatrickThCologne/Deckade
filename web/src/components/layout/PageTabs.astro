---
/**
 * The page tabs. They stand on the top edge of the banner like folder tabs, leaning at the
 * same angle as the banner's edge (--lean). On hover the light along the banner's top edge
 * glides over under the tab (scripts/tab-light.ts), and a thin gold line runs up the tab's
 * left edge and round the corner along its top; from tab to tab it crawls over like a snake
 * (scripts/tab-trace.ts).
 */
import type { Locale } from '../../config/site';
import { useTranslations } from '../../lib/i18n';
import { localePath } from '../../lib/links';

export type Tab = 'overview' | 'cards' | 'rotation' | 'search';

interface Props {
  current: Tab;
  locale: Locale;
}

const { current, locale } = Astro.props;
const { t } = useTranslations(locale);
const tabs = [
  {
    id: 'overview',
    href: localePath(locale),
    label: t('tabs.overview'),
    short: t('tabs.overview.short'),
  },
  {
    id: 'cards',
    href: localePath(locale, 'cards'),
    label: t('tabs.cards'),
    short: t('tabs.cards.short'),
  },
  {
    id: 'rotation',
    href: localePath(locale, 'rotation'),
    label: t('tabs.rotation'),
    short: t('tabs.rotation.short'),
  },
  {
    id: 'search',
    href: localePath(locale, 'search'),
    label: t('tabs.search'),
    short: t('tabs.search.short'),
  },
] as const; // short: the label on narrow screens
---

<nav class="tabs" aria-label={t('tabs.label')} data-tabs>
  {tabs.map((tab) => (
    <a class="tab" href={tab.href} aria-current={tab.id === current ? 'page' : undefined}>
      <span>
        <span class="long">{tab.label}</span>
        <span class="short">{tab.short}</span>
      </span>
    </a>
  ))}
  <canvas class="trace" data-tab-trace aria-hidden="true"></canvas>
</nav>

<script>
  import { initTabLight } from '../../scripts/tab-light';
  import { initTabTrace } from '../../scripts/tab-trace';

  initTabLight();
  initTabTrace();
</script>

<style>
  .tabs {
    /* The tabs' offsets are measured from here (scripts/tab-light.ts) */
    position: relative;
    display: flex;
  }

  .tab {
    --tab-bg: rgb(10 11 15 / 0.82);
    /* How far the top edge leans to the right; the shape below stays inside the tab */
    --lean-x: 10px;
    position: relative;
    isolation: isolate;
    flex: none;
    padding: 9px calc(var(--lean-x) + 22px) 8px;
    color: var(--text-dim);
    text-decoration: none;
    font-family: var(--font-display), sans-serif;
    font-size: 14.5px;
    font-weight: var(--font-display-weight);
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: color 0.15s;
  }

  /* Side by side: each shape starts where the one before ends at its foot, a hairline apart,
     so the leaning edges run parallel */
  .tab + .tab {
    margin-left: calc(1px - var(--lean-x));
  }

  /* The shape: a parallelogram standing on the banner's edge */
  .tab::before {
    content: '';
    position: absolute;
    inset: 0 var(--lean-x) 0 0;
    transform: skewX(var(--lean));
    transform-origin: bottom left;
    background: var(--tab-bg);
    transition: background 0.2s;
  }

  .tab > span {
    position: relative;
    z-index: 1;
  }

  .short {
    display: none;
  }

  .tab:hover,
  .tab:focus-visible {
    --tab-bg: rgb(30 33 42 / 0.94);
    color: var(--text);
  }

  /* The gold line on hover, drawn by the script on this canvas over all tabs: it comes up the
     left edge of the first tab the pointer reaches and crawls on from tab to tab. It shows at
     once and fades out when the pointer leaves the tabs. */
  .trace {
    --trace: rgb(242 193 78 / 0.75);
    position: absolute;
    top: 0;
    left: 0;
    opacity: 0;
    transition: opacity 0.25s;
    pointer-events: none;
  }

  .trace[data-on] {
    opacity: 1;
    transition: none;
  }

  .tab[aria-current='page'] {
    --tab-bg: var(--accent);
    color: #04110c;
  }

  @media (max-width: 480px) {
    .tab {
      --lean-x: 8px;
      padding-inline: calc(var(--lean-x) + 9px);
      font-size: 13px;
    }

    .long {
      display: none;
    }

    .short {
      display: inline;
    }
  }
</style>
