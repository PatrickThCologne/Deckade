---
/**
 * The page tabs. They stand on the top edge of the banner like folder tabs, leaning at the
 * same angle as the banner's edge (--lean). On hover two stripes sweep through the tab and
 * a bar shoots out of it to the right, along the banner's edge. There is one bar for all
 * tabs, so moving between them slides it over (scripts/tab-bar.ts).
 */
import type { Locale } from '../../config/site';
import { useTranslations } from '../../lib/i18n';
import { localePath } from '../../lib/links';

export type Tab = 'overview' | 'cards' | 'rotation' | 'search';

interface Props {
  current: Tab;
  locale: Locale;
}

const { current, locale } = Astro.props;
const { t } = useTranslations(locale);
const tabs = [
  {
    id: 'overview',
    href: localePath(locale),
    label: t('tabs.overview'),
    short: t('tabs.overview.short'),
  },
  {
    id: 'cards',
    href: localePath(locale, 'cards'),
    label: t('tabs.cards'),
    short: t('tabs.cards.short'),
  },
  {
    id: 'rotation',
    href: localePath(locale, 'rotation'),
    label: t('tabs.rotation'),
    short: t('tabs.rotation.short'),
  },
  {
    id: 'search',
    href: localePath(locale, 'search'),
    label: t('tabs.search'),
    short: t('tabs.search.short'),
  },
] as const; // short: the label on narrow screens
---

<nav class="tabs" aria-label={t('tabs.label')} data-tabs>
  {tabs.map((tab) => (
    <a class="tab" href={tab.href} aria-current={tab.id === current ? 'page' : undefined}>
      <span>
        <span class="long">{tab.label}</span>
        <span class="short">{tab.short}</span>
      </span>
    </a>
  ))}
  <span class="bar" aria-hidden="true"></span>
</nav>

<script>
  import { initTabBar } from '../../scripts/tab-bar';

  initTabBar();
</script>

<style>
  .tabs {
    position: relative;
    display: flex;
    gap: 3px;
    /* The bar ends where the banner ends */
    overflow: clip;
    container-type: inline-size;
  }

  .tab {
    --tab-bg: rgb(10 11 15 / 0.82);
    /* How far the top edge leans to the right; the shape below stays inside the tab */
    --lean-x: 10px;
    position: relative;
    isolation: isolate;
    flex: none;
    padding: 9px calc(var(--lean-x) + 16px) 8px;
    color: var(--text-dim);
    text-decoration: none;
    font-family: var(--font-display), sans-serif;
    font-size: 14.5px;
    font-weight: var(--font-display-weight);
    letter-spacing: 0.02em;
    white-space: nowrap;
    transition: color 0.15s;
  }

  /* Shape and stripe: parallelograms standing on the banner's edge */
  .tab::before,
  .tab::after {
    content: '';
    position: absolute;
    inset: 0 var(--lean-x) 0 0;
    transform: skewX(var(--lean));
    transform-origin: bottom left;
  }

  .tab::before {
    background: var(--tab-bg);
    transition: background 0.2s;
  }

  /* Two solid stripes, a narrow one trailing a wide one, parallel to the slanted edges. On
     hover they sweep through once behind the label: gold on the dark tabs, white on the gold
     one. At rest they wait just outside the tab. */
  .tab::after {
    --stripe: var(--accent);
    background: linear-gradient(
        90deg,
        var(--stripe) 0 5px,
        transparent 5px 11px,
        var(--stripe) 11px 25px,
        transparent 25px
      ) -30px
      0 / 26px 100% no-repeat;
    pointer-events: none;
  }

  .tab[aria-current='page']::after {
    --stripe: #fff;
  }

  .tab > span {
    position: relative;
    z-index: 1;
  }

  .short {
    display: none;
  }

  .tab:hover,
  .tab:focus-visible {
    --tab-bg: rgb(30 33 42 / 0.94);
    color: var(--text);
  }

  .tab:hover::after,
  .tab:focus-visible::after {
    animation: sweep 0.6s cubic-bezier(0.45, 0, 0.25, 1);
  }

  .tab[aria-current='page'] {
    --tab-bg: var(--accent);
    color: #04110c;
  }

  @keyframes sweep {
    to {
      background-position: calc(100% + 30px) 0;
    }
  }

  /* The bar: grows out of the hovered tab's foot to the right and fades in from a soft start */
  .bar {
    position: absolute;
    left: 0;
    bottom: 0;
    z-index: 1;
    width: 100cqw;
    height: 3px;
    background: linear-gradient(
      90deg,
      rgb(242 193 78 / 0),
      var(--accent) 14px,
      rgb(242 193 78 / 0.35) 45%,
      transparent
    );
    transform-origin: left;
    translate: var(--bar-x, 0px) 0;
    scale: 0 1;
    opacity: 0;
    transition:
      scale 0.3s ease-in,
      opacity 0.3s ease-in;
    pointer-events: none;
  }

  .tabs[data-bar] .bar {
    scale: 1 1;
    opacity: 1;
    transition:
      translate 0.4s var(--ease-out),
      scale 0.55s var(--ease-out),
      opacity 0.2s;
  }

  @media (max-width: 480px) {
    .tab {
      --lean-x: 8px;
      padding-inline: calc(var(--lean-x) + 9px);
      font-size: 13px;
    }

    .long {
      display: none;
    }

    .short {
      display: inline;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .tab:hover::after,
    .tab:focus-visible::after {
      animation: none;
    }

    .bar,
    .tabs[data-bar] .bar {
      transition: opacity 0.2s;
    }
  }
</style>
