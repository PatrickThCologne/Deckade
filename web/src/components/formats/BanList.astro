---
import type { Locale } from '../../config/site';
import type { GameFormat } from '../../lib/data/schema';
import { useTranslations } from '../../lib/i18n';

interface Props {
  format: GameFormat;
  locale: Locale;
}

const { format, locale } = Astro.props;
const { t } = useTranslations(locale);
const name = t(`format.${format.id}`);
---

<section class="container banlist" id="banlist" aria-labelledby="banlist-heading">
  <header>
    <h2 id="banlist-heading">
      {t('banlist.heading')} · {name}
    </h2>
    <a class="text-link" href={format.banlistUrl} rel="noopener">
      {t('banlist.official')} ↗
    </a>
  </header>
  {format.banned.length === 0 ? (
    <p class="dim">{t('banlist.empty', { format: name })}</p>
  ) : (
    <>
      <p class="dim">{t('banlist.lead', { format: name })}</p>
      <ul class="cards" role="list">
        {format.banned.map((card) => (
          <li>
            <a href={card.scryfallUrl} target="_blank" rel="noopener" title={t('link.scryfall')}>
              {card.imageNormal ? (
                <img
                  src={card.imageNormal}
                  alt={card.name}
                  width="244"
                  height="340"
                  loading="lazy"
                  decoding="async"
                />
              ) : (
                <span class="placeholder">{card.name}</span>
              )}
              <span class="name">{card.name}</span>
            </a>
          </li>
        ))}
      </ul>
    </>
  )}
</section>

<style>
  .banlist {
    margin-top: 64px;
    scroll-margin-top: 80px;
  }

  header {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 8px 16px;
    padding-bottom: 12px;
    margin-bottom: 10px;
    border-bottom: 1px solid var(--line);
  }

  h2 {
    font-size: clamp(20px, 2.4vw, 26px);
    color: var(--special);
  }

  .cards {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(140px, 1fr));
    gap: 14px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  a {
    display: flex;
    flex-direction: column;
    gap: 6px;
    text-decoration: none;
  }

  img {
    width: 100%;
    height: auto;
    border-radius: 8px;
    box-shadow: 0 10px 24px -12px rgb(0 0 0 / 0.8);
    transition: transform 0.2s var(--ease-out);
  }

  a:hover img {
    transform: translateY(-4px);
  }

  .placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 244 / 340;
    border: 1px solid var(--line);
    border-radius: 8px;
    padding: 10px;
    text-align: center;
    font-size: 12px;
    color: var(--text-dim);
  }

  .name {
    font-size: 12.5px;
    color: var(--text-dim);
    line-height: 1.3;
  }
</style>
