---
/**
 * The banner at the top of every tab page: the page tabs stand on its top edge, the headline
 * is on the left, key figures on the right. The rotation tab adds a radar sweep behind it.
 */
import type { Locale } from '../../config/site';
import PageTabs, { type Tab } from '../layout/PageTabs.astro';
import type { HeroStat } from './types';

interface Props {
  tab: Tab;
  locale: Locale;
  eyebrow: string;
  title: string;
  stats?: readonly HeroStat[];
  radar?: boolean;
}

const { tab, locale, eyebrow, title, stats = [], radar = false } = Astro.props;
---

<section class="hero container" aria-labelledby="hero-title">
  <PageTabs current={tab} locale={locale} />
  <div class="card">
    <div class="surface" aria-hidden="true">
      {radar && <div class="radar"></div>}
    </div>
    <div class="copy">
      <p class="eyebrow">{eyebrow}</p>
      <h1 id="hero-title">{title}</h1>
      <slot />
    </div>
    {stats.length > 0 && (
      <ul class="stats" role="list">
        {stats.map((stat) => {
          const Tag = stat.href ? 'a' : 'div';
          return (
            <li>
              <Tag class:list={['stat', `stat--${stat.tone}`]} href={stat.href}>
                <span class="value mono">{stat.value}</span>
                <span class="label">{stat.label}</span>
              </Tag>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</section>

<style>
  .card {
    --skew: var(--lean);
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    /* More room on the right: the slanted right edge comes closer towards the bottom */
    padding: 22px clamp(36px, 4vw, 56px) 22px clamp(20px, 3vw, 32px);
  }

  /* See-through, so the artwork behind shows. Leans like the tabs: its left edge continues
     the first tab's edge downwards. */
  .surface {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: linear-gradient(100deg, rgb(10 11 15 / 0.82), rgb(10 11 15 / 0.45));
    border: 1px solid var(--line);
    box-shadow: var(--shadow), var(--inner-highlight);
    transform: skewX(var(--skew));
    transform-origin: top left;
  }

  /* Rings and a slowly turning beam, cut off by the surface. Leans back against the
     surface's slant, so the circle stays round. */
  .radar {
    position: absolute;
    right: -120px;
    top: 50%;
    width: 420px;
    aspect-ratio: 1;
    margin-top: -210px;
    border-radius: 50%;
    background:
      repeating-radial-gradient(circle, transparent 0 46px, rgb(242 193 78 / 0.08) 47px 48px),
      conic-gradient(from 0deg, rgb(242 193 78 / 0.16), transparent 70deg);
    mask: radial-gradient(circle, #000 55%, transparent 71%);
    transform: skewX(calc(var(--skew) * -1)) rotate(0turn);
    animation: radar 9s linear infinite;
  }

  @keyframes radar {
    to {
      transform: skewX(calc(var(--skew) * -1)) rotate(1turn);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .radar {
      animation: none;
    }
  }

  .copy {
    min-width: 0;
  }

  .eyebrow {
    font-size: 15px;
  }

  h1 {
    margin: 6px 0 8px;
    font-size: clamp(30px, 4.1vw, 48px);
  }

  .copy :global(p:not(.eyebrow)) {
    margin: 0;
    max-width: 60ch;
    color: var(--text-dim);
  }

  .stats {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(108px, auto);
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stat {
    display: flex;
    flex-direction: column;
    gap: 2px;
    height: 100%;
    --cut: 12px;
    padding: 12px 18px 12px 16px;
    clip-path: polygon(0 0, calc(100% - var(--cut)) 0, 100% var(--cut), 100% 100%, 0 100%);
    background: rgb(255 255 255 / 0.04);
    border-left: 2px solid var(--line-strong);
    text-decoration: none;
  }

  a.stat:hover {
    border-color: var(--line-strong);
  }

  .value {
    font-family: var(--font-display), sans-serif;
    font-size: 26px;
    font-weight: var(--font-display-weight);
    line-height: 1.1;
  }

  .label {
    color: var(--text-dim);
    font-size: 12.5px;
    line-height: 1.3;
  }

  .stat--hot .value {
    color: var(--hot);
  }

  .stat--calm .value {
    color: var(--calm);
  }

  .stat--accent .value {
    color: var(--accent);
  }

  .stat--special .value {
    color: var(--special);
  }

  @media (max-width: 900px) {
    .card {
      --skew: 0deg;
      grid-template-columns: 1fr;
      gap: 18px;
      padding-inline: clamp(20px, 3vw, 32px);
    }

    .surface {
      border-radius: 0 var(--radius-lg) var(--radius-lg);
    }

    .radar {
      right: -200px;
      opacity: 0.6;
    }

    .stats {
      grid-auto-flow: row;
      grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
    }

    .stat {
      padding: 10px 12px;
    }

    .value {
      font-size: 22px;
    }
  }
</style>
