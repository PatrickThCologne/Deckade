---
/**
 * The banner at the top of every tab page: the page tabs stand on its top edge, the headline
 * is on the left, key figures on the right. A gold line runs down its slanted left edge and
 * thin gold corners fade out along its edges. A light along the top edge sits under the
 * current tab and follows the pointer from tab to tab (scripts/tab-light.ts). The rotation
 * tab adds a radar sweep behind it.
 */
import type { Locale } from '../../config/site';
import PageTabs, { type Tab } from '../layout/PageTabs.astro';
import type { HeroStat } from './types';

interface Props {
  tab: Tab;
  locale: Locale;
  /** A short label above the title; the search tab has none */
  eyebrow?: string;
  title: string;
  stats?: readonly HeroStat[];
  radar?: boolean;
}

const { tab, locale, eyebrow, title, stats = [], radar = false } = Astro.props;
---

<section class="hero container" aria-labelledby="hero-title" data-tab-light>
  <PageTabs current={tab} locale={locale} />
  <div class="card" data-light-frame>
    <div class="surface" aria-hidden="true">
      {radar && <div class="radar"></div>}
    </div>
    <div class="copy">
      {eyebrow && <p class="eyebrow">{eyebrow}</p>}
      <h1 id="hero-title">{title}</h1>
      <slot />
    </div>
    {stats.length > 0 && (
      <ul class="stats" role="list">
        {stats.map((stat) => {
          const Tag = stat.href ? 'a' : 'div';
          return (
            <li>
              <Tag class:list={['stat', `stat--${stat.tone}`]} href={stat.href}>
                <span class="value mono">{stat.value}</span>
                <span class="label">{stat.label}</span>
              </Tag>
            </li>
          );
        })}
      </ul>
    )}
  </div>
</section>

<style>
  /* Where the tab light is brightest, measured from the banner's left edge. Registered, so a
     new position glides instead of jumping. Far off to the left until the script places it. */
  @property --light-x {
    syntax: '<length>';
    inherits: true;
    initial-value: -10000px;
  }

  .hero {
    /* How far the light reaches from its brightest point: to the left, along the edge and
       round the corner; to the right at least as far, and from the last tab on past the top
       right corner (--light-span, set by the script), as the banner is wider on that side */
    --light-reach: min(560px, 45vw);
    --light-reach-right: max(var(--light-reach), var(--light-span, 0px));
  }

  .hero[data-light-glide] {
    transition: --light-x 0.45s var(--ease-out);
  }

  .card {
    --skew: var(--lean);
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 28px;
    align-items: center;
    /* More room on the right: the slanted right edge comes closer towards the bottom, and the
       figures keep a clear distance from it */
    padding: 22px clamp(56px, 7vw, 100px) 22px clamp(20px, 3vw, 32px);
  }

  /* See-through, so the artwork behind shows. Leans like the tabs: its left edge continues
     the first tab's edge downwards. The hairline round it is a shadow, not a border, so the
     lines below can lie on the very edge and are cut off by the rounded corners. */
  .surface {
    position: absolute;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    background: linear-gradient(100deg, rgb(13 14 18 / 0.9), rgb(13 14 18 / 0.74));
    box-shadow:
      var(--shadow),
      inset 0 0 0 1px var(--line),
      var(--inner-highlight);
    transform: skewX(var(--skew));
    transform-origin: top left;
  }

  /* Lines on the edges. The tab light starts under its tab and runs along the edges both
     ways, fading as it goes; where it reaches a corner it carries on round it. The script
     measures the banner (--light-w, --light-h) and switches the light on (--light-on). The
     top edge stays level when the surface leans (it leans from its top left corner), so the
     light sits there exactly under the tabs. Layers, from top to bottom of the list: the top
     edge; on round the top left corner, down the left edge; on round the bottom left corner,
     along the bottom; on round the top right corner, down the right edge; and under all of
     them the gold line down the left edge, fading towards the bottom. To the right the light
     keeps more of its strength for longer (--light-held at three quarters of the way), so it
     still shows where it turns the far corner. The upright lines and the bottom one start
     2px off their corner, so no two lines lie on top of each other there. */
  .surface::before {
    --light: rgb(242 193 78 / var(--light-on, 0));
    --light-held: rgb(242 193 78 / calc(var(--light-on, 0) * 0.65));
    --past-left: var(--light-x);
    --past-bottom-left: calc(var(--light-x) + var(--light-h, 0px));
    --past-right: calc(var(--light-w, 0px) - var(--light-x));
    content: '';
    position: absolute;
    inset: 0;
    z-index: 1;
    background:
      linear-gradient(
          90deg,
          transparent calc(var(--light-x) - var(--light-reach)),
          var(--light) var(--light-x),
          var(--light-held) calc(var(--light-x) + var(--light-reach-right) * 0.75),
          transparent calc(var(--light-x) + var(--light-reach-right))
        )
        0 0 / 100% 2px no-repeat,
      linear-gradient(180deg, var(--light), transparent) 0 calc(2px - var(--past-left)) / 2px
        var(--light-reach) no-repeat,
      linear-gradient(90deg, var(--light), transparent) calc(2px - var(--past-bottom-left)) 100% /
        var(--light-reach) 2px no-repeat,
      linear-gradient(
          180deg,
          var(--light),
          var(--light-held) calc(var(--light-reach-right) * 0.75),
          transparent var(--light-reach-right)
        )
        100% calc(2px - var(--past-right)) / 2px var(--light-reach-right) no-repeat,
      linear-gradient(180deg, rgb(242 193 78 / 0.4), rgb(242 193 78 / 0.08)) 0 2px / 2px
        calc(100% - 4px) no-repeat;
    pointer-events: none;
  }

  /* Thin gold corners whose arms fade out along the edges; shorter on narrow screens, so
     they stay corners instead of meeting. The upright arms start a pixel off the corner, so
     the two arms do not cover the corner pixel twice. */
  .surface::after {
    --corner: rgb(242 193 78 / 0.7);
    --arm: min(160px, 22vw);
    --arm-v: calc(var(--arm) * 0.6);
    content: '';
    position: absolute;
    inset: 9px;
    z-index: 1;
    background:
      linear-gradient(90deg, var(--corner), transparent) 0 0 / var(--arm) 1px no-repeat,
      linear-gradient(180deg, var(--corner), transparent) 0 1px / 1px var(--arm-v) no-repeat,
      linear-gradient(270deg, var(--corner), transparent) 100% 0 / var(--arm) 1px no-repeat,
      linear-gradient(180deg, var(--corner), transparent) 100% 1px / 1px var(--arm-v) no-repeat,
      linear-gradient(90deg, var(--corner), transparent) 0 100% / var(--arm) 1px no-repeat,
      linear-gradient(0deg, var(--corner), transparent) 0 calc(100% - 1px) / 1px var(--arm-v)
        no-repeat,
      linear-gradient(270deg, var(--corner), transparent) 100% 100% / var(--arm) 1px no-repeat,
      linear-gradient(0deg, var(--corner), transparent) 100% calc(100% - 1px) / 1px var(--arm-v)
        no-repeat;
    pointer-events: none;
  }

  /* Rings and a slowly turning beam, cut off by the surface. Leans back against the
     surface's slant, so the circle stays round. */
  .radar {
    position: absolute;
    right: -120px;
    top: 50%;
    width: 420px;
    aspect-ratio: 1;
    margin-top: -210px;
    border-radius: 50%;
    background:
      repeating-radial-gradient(circle, transparent 0 46px, rgb(242 193 78 / 0.08) 47px 48px),
      conic-gradient(from 0deg, rgb(242 193 78 / 0.16), transparent 70deg);
    mask: radial-gradient(circle, #000 55%, transparent 71%);
    transform: skewX(calc(var(--skew) * -1)) rotate(0turn);
    animation: radar 9s linear infinite;
  }

  @keyframes radar {
    to {
      transform: skewX(calc(var(--skew) * -1)) rotate(1turn);
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .radar {
      animation: none;
    }

    .hero[data-light-glide] {
      transition: none;
    }
  }

  .copy {
    min-width: 0;
  }

  /* The label ends in a short gold rule */
  .eyebrow {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 15px;
  }

  .eyebrow::after {
    content: '';
    width: 56px;
    height: 1px;
    background: linear-gradient(90deg, currentColor, transparent);
    opacity: 0.7;
  }

  h1 {
    margin: 6px 0 8px;
    font-size: clamp(30px, 4.1vw, 48px);
    letter-spacing: 0.03em;
  }

  .copy :global(p:not(.eyebrow)) {
    margin: 0;
    max-width: 60ch;
    color: var(--text-dim);
  }

  /* Figures side by side, a small gold gem between two of them */
  .stats {
    display: flex;
    align-items: center;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .stats li {
    display: flex;
    align-items: center;
  }

  .stats li + li::before {
    content: '';
    flex: none;
    width: 6px;
    height: 6px;
    background: rgb(242 193 78 / 0.6);
    transform: rotate(45deg);
  }

  .stat {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 4px;
    padding: 0 22px;
    text-align: center;
    text-decoration: none;
  }

  .stats li:first-child .stat {
    padding-left: 0;
  }

  .stats li:last-child .stat {
    padding-right: 0;
  }

  a.stat:hover .label {
    color: var(--text);
  }

  .value {
    font-family: var(--font-display), sans-serif;
    font-size: 26px;
    font-weight: var(--font-display-weight);
    line-height: 1.1;
  }

  /* Small capitals; a long label breaks into two lines instead of widening the figure */
  .label {
    max-width: 14em;
    color: var(--text-dim);
    font-family: var(--font-display), sans-serif;
    font-size: 11px;
    letter-spacing: 0.12em;
    line-height: 1.35;
    text-transform: uppercase;
    text-wrap: balance;
  }

  .stat--hot .value {
    color: var(--hot);
  }

  .stat--calm .value {
    color: var(--calm);
  }

  .stat--accent .value {
    color: var(--accent);
  }

  .stat--special .value {
    color: var(--special);
  }

  @media (width > 900px) {
    .card {
      min-height: var(--hero-height);
    }

    /* Four figures stand two by two, so the headline keeps the room it has on the other tabs */
    .stats:has(> li:nth-child(4)) {
      display: grid;
      grid-template-columns: repeat(2, auto);
      row-gap: 14px;
      align-items: start;
    }

    /* Figures of a row on one line, even when one label breaks into two lines; the gem
       stays at the height of the figures */
    .stats:has(> li:nth-child(4)) li {
      align-items: flex-start;
    }

    .stats:has(> li:nth-child(4)) li::before {
      margin-top: calc(26px * 1.1 / 2 - 3px);
    }

    /* Each figure in the middle of its column */
    .stats:has(> li:nth-child(4)) .stat {
      flex: 1;
    }

    .stats:has(> li:nth-child(4)) li:nth-child(3)::before {
      display: none;
    }

    .stats:has(> li:nth-child(4)) li:nth-child(odd) .stat {
      padding-left: 0;
    }

    .stats:has(> li:nth-child(4)) li:nth-child(even) .stat {
      padding-right: 0;
    }
  }

  @media (max-width: 900px) {
    .card {
      --skew: 0deg;
      grid-template-columns: 1fr;
      gap: 18px;
      padding-inline: clamp(20px, 3vw, 32px);
    }

    .surface {
      border-radius: 0 var(--radius-lg) var(--radius-lg);
    }

    .radar {
      right: -200px;
      opacity: 0.6;
    }

    /* Narrow: the figures may wrap, so they stand in a grid without gems, aligned left */
    .stats {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(96px, 1fr));
      gap: 14px 12px;
      align-items: start;
    }

    .stats li + li::before {
      display: none;
    }

    .stat,
    .stats li:first-child .stat,
    .stats li:last-child .stat {
      align-items: flex-start;
      padding: 0;
      text-align: start;
    }

    .value {
      font-size: 22px;
    }
  }
</style>
