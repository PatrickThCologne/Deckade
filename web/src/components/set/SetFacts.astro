---
/** Two key figures of a set, side by side: release date and number of cards. */
import type { Locale } from '../../config/site';
import { childSets } from '../../lib/data/load';
import type { MtgSet } from '../../lib/data/schema';
import { createFormatters } from '../../lib/format';
import { useTranslations } from '../../lib/i18n';

interface Props {
  set: MtgSet;
  /** Cards shown on the page, bonus sheets included. */
  cardCount: number;
  locale: Locale;
}

const { set, cardCount, locale } = Astro.props;
const { t } = useTranslations(locale);
const format = createFormatters(locale);
const children = childSets(set);
const upcoming = set.standard?.status === 'upcoming';
---

<div class="facts">
  <div class="fact">
    <span class="label">{upcoming ? t('facts.releases') : t('facts.released')}</span>
    <span class="value">{format.date(set.releasedAt)}</span>
  </div>
  <div class="fact">
    <span class="label">
      {t('facts.cards')}
      {upcoming && <span class="dim"> · {t('facts.knownSoFar')}</span>}
    </span>
    <span class="value">{format.integer(cardCount)}</span>
    {children.length > 0 && (
      <span class="note">
        {t('facts.includes', { sets: children.map((c) => c.name).join(', ') })}
      </span>
    )}
  </div>
</div>

<style>
  /* Both figures share one gold strip; it runs past the card count and fades out there */
  .facts {
    --fade: 40px;
    display: flex;
    width: fit-content;
    max-width: 100%;
    padding-right: var(--fade);
    background: linear-gradient(
      90deg,
      var(--accent-soft),
      rgb(242 193 78 / 0.1) calc(100% - var(--fade)),
      transparent
    );
  }

  .fact {
    display: flex;
    flex-direction: column;
    gap: 2px;
    min-width: 0;
    padding: 10px 16px;
  }

  .label {
    font-family: var(--font-display), sans-serif;
    font-size: 11.5px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  .value {
    font-family: var(--font-display), sans-serif;
    font-size: 24px;
    font-weight: 700;
    line-height: 1.1;
    font-variant-numeric: tabular-nums;
  }

  .note {
    font-size: 12px;
    color: var(--text-dim);
  }
</style>
