---
import HeroPanel from '../../components/hero/HeroPanel.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../lib/i18n';
import { localeFrom, localePaths } from '../../lib/routing';

export const getStaticPaths = localePaths;

const locale = localeFrom(Astro.params.lang);
const { t } = useTranslations(locale);
---

<BaseLayout locale={locale} title={t('search.title')} description={t('search.text')}>
  <HeroPanel tab="search" locale={locale} eyebrow={t('search.eyebrow')} title={t('search.title')}>
    <p>{t('search.text')}</p>
  </HeroPanel>
</BaseLayout>
