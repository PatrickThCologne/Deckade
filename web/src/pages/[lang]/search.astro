---
/**
 * The search tab: a request in plain language becomes filters over the card list of the
 * "All cards" tab (lib/search/query.ts). It runs in the browser (scripts/card-search.ts);
 * the request is kept in the address (?q=…), so a search can be shared.
 */
import HeroPanel from '../../components/hero/HeroPanel.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { CARD_TYPES, SORT_KEYS } from '../../lib/cards/sort';
import { useTranslations } from '../../lib/i18n';
import { withBase } from '../../lib/links';
import { COLORS } from '../../lib/mana';
import { localeFrom, localePaths } from '../../lib/routing';
import { KEYWORDS } from '../../lib/search/keywords';

export const getStaticPaths = localePaths;

const locale = localeFrom(Astro.params.lang);
const { t } = useTranslations(locale);

const examples =
  locale === 'de'
    ? [
        'günstige rote Kreaturen mit Eile',
        'Azorius Flieger bis 3 Mana',
        'beliebte grüne Karten unter 2 €',
        'farblose Artefakte',
      ]
    : [
        'cheap red creatures with haste',
        'Azorius flyers up to 3 mana',
        'popular green cards under 2 €',
        'colourless artifacts',
      ];

const labels = {
  colors: Object.fromEntries(COLORS.map((color) => [color, t(`color.${color}`)])),
  types: Object.fromEntries(CARD_TYPES.map((type) => [type, t(`type.${type}`)])),
  keywords: Object.fromEntries(KEYWORDS.map((keyword) => [keyword, t(`keyword.${keyword}`)])),
  sorts: Object.fromEntries(SORT_KEYS.map((key) => [key, t(`sort.${key}`)])),
  understood: t('search.understood'),
  colorless: t('search.colorless'),
  exactly: t('search.exactly'),
  manaMax: t('search.manaMax'),
  manaExact: t('search.manaExact'),
  priceMax: t('search.priceMax'),
  name: t('search.name'),
  ignored: t('search.ignored'),
  count: t('search.count'),
  none: t('search.none'),
  loading: t('cards.loading'),
  error: t('cards.loadError'),
  more: t('cards.more'),
  scryfall: t('link.scryfall'),
};
---

<BaseLayout locale={locale} title={t('search.title')} description={t('search.text')}>
  <HeroPanel tab="search" locale={locale} eyebrow={t('search.eyebrow')} title={t('search.title')}>
    <p>{t('search.text')}</p>
  </HeroPanel>

  <div
    class="container search"
    data-card-search
    data-src={withBase(`${locale}/cards.json`)}
    data-locale={locale}
    data-labels={JSON.stringify(labels)}
  >
    <form class="panel ask" role="search" data-search-form>
      <label for="search-query">{t('search.label')}</label>
      <div class="field">
        <input
          id="search-query"
          name="q"
          type="search"
          autocomplete="off"
          maxlength="200"
          placeholder={t('search.placeholder')}
        />
        <button type="submit">{t('search.submit')}</button>
      </div>
      <p class="examples">
        <span>{t('search.examples')}:</span>
        {examples.map((example) => (
          <button type="button" class="example" data-example>
            {example}
          </button>
        ))}
      </p>
    </form>

    <p class="understood" data-understood aria-live="polite" hidden></p>
    <p class="status" data-status hidden></p>
    <ul class="results" role="list" data-results></ul>
    <button type="button" class="more" data-more hidden></button>
  </div>
</BaseLayout>

<script>
  import { initCardSearch } from '../../scripts/card-search';

  void initCardSearch();
</script>

<style>
  .search {
    padding-block: 6px 48px;
  }

  .ask {
    display: grid;
    gap: 10px;
    padding: 18px 22px;
  }

  label {
    font-family: var(--font-display), sans-serif;
    font-size: 15px;
  }

  .field {
    display: flex;
    gap: 10px;
  }

  input {
    flex: 1;
    min-width: 0;
    height: 44px;
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    background: var(--bg);
    color: var(--text);
    font: inherit;
    font-size: 16px;
  }

  input:focus {
    border-color: var(--accent);
    outline: 0;
  }

  .field button {
    height: 44px;
    padding: 0 20px;
    border: 1px solid var(--accent);
    border-radius: 999px;
    background: var(--accent);
    color: var(--bg);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
  }

  .examples {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 8px;
    margin: 0;
    font-size: 13px;
    color: var(--text-faint);
  }

  .example {
    padding: 4px 10px;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: none;
    color: var(--text-dim);
    font: inherit;
    cursor: pointer;
  }

  .example:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  /* What the request was read as: a caption, then one small pill per filter */
  .understood {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px;
    margin: 16px 0 0;
  }

  .understood[hidden],
  .status[hidden],
  .more[hidden] {
    display: none;
  }

  .understood :global(.caption) {
    margin-right: 4px;
    font-family: var(--font-mono), monospace;
    font-size: 10.5px;
    font-weight: 600;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--text-faint);
  }

  .understood :global(.chip) {
    padding: 3px 10px;
    border: 1px solid rgb(242 193 78 / 0.45);
    border-radius: 999px;
    color: var(--text);
    font-size: 13px;
  }

  .understood :global(.chip--ignored) {
    border-color: var(--line);
    color: var(--text-faint);
  }

  .status {
    margin: 16px 0 0;
    color: var(--text-dim);
  }

  .results {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(160px, 1fr));
    gap: 16px 12px;
    margin: 16px 0 0;
    padding: 0;
    list-style: none;
  }

  .results :global(a) {
    display: grid;
    gap: 6px;
    color: var(--text);
    text-decoration: none;
  }

  .results :global(img),
  .results :global(.no-image) {
    width: 100%;
    height: auto;
    aspect-ratio: 488 / 680;
    border-radius: 4.5% / 3.2%;
    background: var(--surface-solid);
    box-shadow: var(--shadow);
  }

  .results :global(a:hover img) {
    outline: 2px solid var(--accent);
  }

  .results :global(.name) {
    font-size: 13.5px;
    line-height: 1.3;
  }

  .results :global(.price) {
    color: var(--text-dim);
    font-size: 12.5px;
  }

  .more {
    display: block;
    margin: 20px auto 0;
    padding: 9px 18px;
    border: 1px solid var(--line-strong);
    border-radius: 999px;
    background: var(--surface-solid);
    color: var(--text-dim);
    font: inherit;
    font-size: 13.5px;
    cursor: pointer;
  }

  .more:hover {
    border-color: var(--accent);
    color: var(--accent);
  }

  @media (max-width: 560px) {
    .results {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
</style>
