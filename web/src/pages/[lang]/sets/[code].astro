---
import CardTable from '../../../components/set/CardTable.astro';
import ProductStrip from '../../../components/set/ProductStrip.astro';
import SetFacts from '../../../components/set/SetFacts.astro';
import { LOCALES } from '../../../config/site';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { shownCard } from '../../../lib/cards/local';
import { mainSets, setCards, snapshot } from '../../../lib/data/load';
import type { MtgSet } from '../../../lib/data/schema';
import { createFormatters } from '../../../lib/format';
import { useTranslations } from '../../../lib/i18n';
import { localePath, withBase } from '../../../lib/links';
import { localeFrom } from '../../../lib/routing';
import { createRotationText } from '../../../lib/rotation/describe';

export function getStaticPaths() {
  return LOCALES.flatMap((lang) =>
    mainSets().map((set) => ({ params: { lang, code: set.code }, props: { set } })),
  );
}

interface Props {
  set: MtgSet;
}

const { set } = Astro.props;
const locale = localeFrom(Astro.params.lang);
const { t, plural } = useTranslations(locale);
const format = createFormatters(locale);
const rotationText = createRotationText(locale, snapshot.rotation);

// Bonus sheets ("The Big Score") are listed together with their main set.
const cards = setCards(set);
const firstWithImage = cards.find((card) => card.imageNormal);
const preview = firstWithImage && {
  ...shownCard(firstWithImage, locale),
  price: firstWithImage.price,
};
const description = set.standard
  ? t('meta.set.description', {
      name: set.name,
      rotation: rotationText.forSet(set.standard.rotation),
      cards: plural('count.cards', cards.length),
    })
  : t('meta.set.descriptionFormats', {
      name: set.name,
      formats: set.formats.map((id) => t(`format.${id}`)).join(', '),
      cards: plural('count.cards', cards.length),
    });
---

<BaseLayout
  locale={locale}
  title={t('meta.set.title', { name: set.name })}
  description={description}
  image={set.packImage}
>
  <!--
    The same view is shown as its own page (direct links, search engines) and as an
    overlay above the overview (scripts/set-overlay.ts copies [data-set-view] over).
    A click on the empty space around the columns leads back to the overview.
  -->
  <div class="set-view container" data-set-view data-overview={localePath(locale)}>
    <a class="back" href={localePath(locale)} data-leave>
      ← {t('set.back')}
    </a>
    <div class="layout" data-leave-area>
      <aside class="pack panel">
        {set.packImage ? (
          <img src={withBase(set.packImage)} alt="" width="300" height="540" data-pack-image />
        ) : (
          set.iconUrl && <img class="icon" src={set.iconUrl} alt="" width="96" height="96" />
        )}
      </aside>

      <article class="main panel" aria-labelledby="set-title">
        <button class="close" type="button" data-leave aria-label={t('overlay.close')}>
          ✕
        </button>
        <p class="eyebrow">
          {set.code.toUpperCase()} · {format.monthYear(set.releasedAt)}
        </p>
        <h1 id="set-title">{set.name}</h1>
        <SetFacts set={set} cardCount={cards.length} locale={locale} />
        <ProductStrip set={set} locale={locale} />
        <CardTable cards={cards} locale={locale} />
      </article>

      <aside class="preview" aria-hidden="true">
        {preview && (
          <figure class="panel">
            <img
              data-preview-image
              src={preview.imageNormal}
              alt=""
              width="488"
              height="680"
              decoding="async"
            />
            <figcaption data-preview-caption>
              {preview.name} · {format.price(preview.price)}
            </figcaption>
          </figure>
        )}
      </aside>
    </div>
  </div>
</BaseLayout>

<script>
  import { initSetView } from '../../../scripts/set-view';

  initSetView(document);
</script>

<style>
  .back {
    display: inline-block;
    margin-bottom: 16px;
    color: var(--text-dim);
    text-decoration: none;
    font-size: 13.5px;
  }

  .back:hover {
    color: var(--accent);
  }

  /*
   * Pack, card list and card preview form one T-shaped panel: pack and preview are the
   * crossbar (row 1), the card list is the stem (rows 1 and 2). They touch without
   * overlapping, so the surface is continuous; the list's left border starts below the pack
   * (::before). The preview slides down along the list while scrolling; the list's right
   * border runs above and below it (.preview figure::before and ::after).
   */
  .layout {
    display: grid;
    grid-template-columns: 210px minmax(0, 1fr) 270px;
    grid-template-rows: auto 1fr;
    cursor: zoom-out;
  }

  /* The space around the panel is the way back. */
  .layout > * {
    cursor: auto;
  }

  .pack {
    grid-area: 1 / 1;
    padding: 16px;
    border-right: 0;
    border-radius: var(--radius-lg) 0 0 var(--radius-lg);
  }

  .pack:empty {
    display: none;
  }

  .pack img {
    width: 100%;
    height: auto;
    filter: drop-shadow(0 22px 30px rgb(0 0 0 / 0.6));
  }

  /* Sets without an official pack image show their symbol, as on the overview */
  .pack .icon {
    display: block;
    width: 96px;
    margin: 24px auto;
    filter: invert(1) opacity(0.7);
  }

  .main {
    grid-area: 1 / 2 / 3 / 3;
    position: relative;
    padding: 22px 24px 26px;
    border-inline: 0;
    border-radius: 0 0 var(--radius-lg) var(--radius-lg);
  }

  /* As tall as the list, so the preview can follow it. The clip keeps the border lines
     within the list; the bottom stays clear of the list's rounded corner. */
  .preview {
    grid-area: 1 / 3 / 3 / 4;
    clip-path: inset(0 -100px var(--radius-lg));
  }

  .layout::before {
    content: '';
    grid-area: 2 / 2;
    z-index: 1;
    width: 1px;
    background: var(--line);
    pointer-events: none;
  }

  /* Without a pack or a preview the list has its own border on that side */
  .layout:not(:has(.pack img)) .main {
    border-left: 1px solid var(--line);
    border-top-left-radius: var(--radius-lg);
  }

  .layout:not(:has(.pack img))::before {
    display: none;
  }

  .layout:not(:has(.preview figure)) .main {
    border-right: 1px solid var(--line);
    border-top-right-radius: var(--radius-lg);
  }

  .close {
    position: absolute;
    top: 14px;
    right: 14px;
    width: 32px;
    height: 32px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: var(--surface-solid);
    color: var(--text-dim);
    font-size: 14px;
    cursor: pointer;
  }

  .close:hover {
    color: var(--text);
    border-color: var(--line-strong);
  }

  h1 {
    margin: 6px 40px 16px 0;
    font-size: clamp(28px, 3.6vw, 40px);
  }

  /* Stops in line with the card filters; the margin keeps it off the list's rounded corner */
  .preview figure {
    position: sticky;
    top: var(--sticky-top, 62px);
    margin: 0 0 var(--radius-lg);
    padding: 12px;
    border-left: 0;
    border-radius: 0 var(--radius-lg) var(--radius-lg) 0;
  }

  /* The list's right border above and below the preview; a screen high covers all in view */
  .preview figure::before,
  .preview figure::after {
    content: '';
    position: absolute;
    right: 100%;
    width: 1px;
    height: 100vh;
    background: var(--line);
    pointer-events: none;
  }

  .preview figure::before {
    bottom: 100%;
  }

  .preview figure::after {
    top: 100%;
  }

  .preview img {
    width: 100%;
    height: auto;
    border-radius: 11px;
  }

  figcaption {
    margin-top: 10px;
    text-align: center;
    font-size: 12.5px;
    color: var(--text-dim);
  }

  @media (max-width: 1120px) {
    .layout {
      grid-template-columns: 170px minmax(0, 1fr);
    }

    .preview {
      display: none;
    }

    .main {
      border-right: 1px solid var(--line);
      border-top-right-radius: var(--radius-lg);
    }
  }

  @media (max-width: 720px) {
    .layout {
      grid-template-columns: 1fr;
      grid-template-rows: none;
      gap: 12px;
    }

    .pack {
      grid-area: auto;
      width: 150px;
      justify-self: center;
      border-right: 1px solid var(--line);
      border-radius: var(--radius-lg);
    }

    .main {
      grid-area: auto;
      border-left: 1px solid var(--line);
      border-radius: var(--radius-lg);
    }

    .layout::before {
      display: none;
    }

    .main {
      padding: 18px 14px 20px;
    }
  }
</style>
