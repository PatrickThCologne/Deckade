---
/**
 * Privacy notice. The site sets no cookies and stores nothing in the browser; data only arises
 * at the host and where images are loaded from Scryfall. Who runs the site comes from the
 * deployment (OPERATOR_NAME, OPERATOR_ADDRESS, OPERATOR_EMAIL), so it is not part of the
 * repository.
 */
import { OPERATOR_ADDRESS, OPERATOR_EMAIL, OPERATOR_NAME } from 'astro:env/server';

import BaseLayout from '../../layouts/BaseLayout.astro';
import { createFormatters } from '../../lib/format';
import { useTranslations } from '../../lib/i18n';
import { localeFrom, localePaths } from '../../lib/routing';

export const getStaticPaths = localePaths;

/** Date of the last change to this text; update it with every change. */
const UPDATED = '2026-11-10';

const locale = localeFrom(Astro.params.lang);
const { t } = useTranslations(locale);
const format = createFormatters(locale);
const operatorKnown = Boolean(OPERATOR_NAME && OPERATOR_EMAIL);

const githubPrivacy =
  'https://docs.github.com/en/site-policy/privacy-policies/github-general-privacy-statement';

const sections = [
  {
    heading: t('privacy.hosting.heading'),
    text: t('privacy.hosting.text'),
    link: { href: githubPrivacy, label: t('privacy.hosting.link') },
  },
  {
    heading: t('privacy.images.heading'),
    text: t('privacy.images.text'),
    link: { href: 'https://scryfall.com/docs/privacy', label: t('privacy.images.link') },
  },
  {
    heading: t('privacy.feedback.heading'),
    text: t('privacy.feedback.text'),
    link: { href: githubPrivacy, label: t('privacy.hosting.link') },
  },
  { heading: t('privacy.local.heading'), text: t('privacy.local.text') },
  { heading: t('privacy.rights.heading'), text: t('privacy.rights.text') },
];
---

<BaseLayout
  locale={locale}
  title={t('meta.privacy.title')}
  description={t('meta.privacy.description')}
>
  <article class="container privacy">
    <p class="eyebrow">{t('nav.privacy')}</p>
    <h1>{t('privacy.heading')}</h1>
    <p class="lead">{t('privacy.intro')}</p>

    <section class="panel block">
      <h2>{t('privacy.controller.heading')}</h2>
      {operatorKnown ? (
        <p>
          {OPERATOR_NAME}
          {OPERATOR_ADDRESS && (
            <Fragment>
              <br />
              {OPERATOR_ADDRESS}
            </Fragment>
          )}
          <br />
          <a class="text-link" href={`mailto:${OPERATOR_EMAIL}`}>
            {OPERATOR_EMAIL}
          </a>
        </p>
      ) : (
        <p class="missing">{t('privacy.controller.missing')}</p>
      )}
    </section>

    {sections.map((section) => (
      <section class="panel block">
        <h2>{section.heading}</h2>
        <p>{section.text}</p>
        {section.link && (
          <a class="text-link" href={section.link.href} rel="noopener">
            {section.link.label} ↗
          </a>
        )}
      </section>
    ))}

    <p class="updated">{t('privacy.updated', { date: format.date(UPDATED) })}</p>
  </article>
</BaseLayout>

<style>
  .privacy {
    max-width: 820px;
    padding-block: 28px 48px;
  }

  h1 {
    margin: 6px 0 10px;
    font-size: clamp(30px, 4vw, 44px);
  }

  .lead {
    margin: 0 0 22px;
    max-width: 64ch;
    color: var(--text-dim);
    font-size: 16px;
  }

  .block {
    margin-top: 12px;
    padding: 18px 22px;
  }

  h2 {
    margin: 0 0 8px;
    font-size: 18px;
  }

  .block p {
    margin: 0 0 8px;
    max-width: 72ch;
    color: var(--text-dim);
    line-height: 1.6;
  }

  .block .missing {
    color: var(--hot);
  }

  .updated {
    margin-top: 18px;
    font-size: 12.5px;
    color: var(--text-faint);
  }
</style>
