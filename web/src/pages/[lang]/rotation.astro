---
import BanList from '../../components/formats/BanList.astro';
import RotationHero from '../../components/rotation/RotationHero.astro';
import WaveSection from '../../components/rotation/WaveSection.astro';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { formatById, standardSets } from '../../lib/data/load';
import { useTranslations } from '../../lib/i18n';
import { localeFrom, localePaths } from '../../lib/routing';
import { groupIntoWaves } from '../../lib/rotation/waves';
import { isShown } from '../../lib/timeline';

export const getStaticPaths = localePaths;

const locale = localeFrom(Astro.params.lang);
const { t } = useTranslations(locale);
const waves = groupIntoWaves(standardSets().filter(isShown));
---

<BaseLayout locale={locale} title={t('meta.home.title')} description={t('meta.home.description')}>
  <RotationHero locale={locale} />
  <div class="container waves">
    {waves.map((wave) => (
      <WaveSection wave={wave} locale={locale} />
    ))}
  </div>
  <BanList format={formatById('standard')} locale={locale} />
</BaseLayout>

<script>
  import { initCoverflow } from '../../scripts/coverflow';
  import { initSetOverlay } from '../../scripts/set-overlay';
  import { initTilt } from '../../scripts/tilt';

  initCoverflow();
  initTilt();
  initSetOverlay();
</script>

<style>
  /* The banner above leans from its top left corner, so the middle of its shape lies half
     its slant left of the page's middle. The sets stand under that middle, as on the
     overview. Narrow screens have an upright banner. */
  @media (width > 900px) {
    .waves {
      translate: calc(var(--hero-height) * tan(var(--lean)) / 2) 0;
    }
  }
</style>
