---
/**
 * Imprint and contact. Who runs the site comes from the deployment (OPERATOR_NAME,
 * OPERATOR_ADDRESS, OPERATOR_EMAIL), so it is not part of the repository; locally the page shows
 * a placeholder instead.
 */
import { OPERATOR_ADDRESS, OPERATOR_EMAIL, OPERATOR_NAME } from 'astro:env/server';

import { SITE_NAME, SOURCE_REPO } from '../../config/site';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { useTranslations } from '../../lib/i18n';
import { mailto } from '../../lib/links';
import { localeFrom, localePaths } from '../../lib/routing';

export const getStaticPaths = localePaths;

const locale = localeFrom(Astro.params.lang);
const { t } = useTranslations(locale);
const operatorKnown = Boolean(OPERATOR_NAME && OPERATOR_EMAIL);
const feedbackLink = OPERATOR_EMAIL
  ? mailto(OPERATOR_EMAIL, t('feedback.subject', { site: SITE_NAME }))
  : undefined;
---

<BaseLayout
  locale={locale}
  title={t('meta.imprint.title')}
  description={t('meta.imprint.description', { site: SITE_NAME })}
>
  <article class="container imprint">
    <p class="eyebrow">{t('nav.imprint')}</p>
    <h1>{t('imprint.heading')}</h1>
    <p class="lead">{t('imprint.intro', { site: SITE_NAME })}</p>

    <section class="panel block">
      <h2>{t('imprint.operator.heading')}</h2>
      {operatorKnown ? (
        <p>
          {OPERATOR_NAME}
          {OPERATOR_ADDRESS && (
            <Fragment>
              <br />
              {OPERATOR_ADDRESS}
            </Fragment>
          )}
          <br />
          <a class="text-link" href={`mailto:${OPERATOR_EMAIL}`}>
            {OPERATOR_EMAIL}
          </a>
        </p>
      ) : (
        <p class="missing">{t('imprint.operator.missing')}</p>
      )}
    </section>

    <section class="panel block" id="feedback">
      <h2>{t('imprint.feedback.heading')}</h2>
      <p>{t('imprint.feedback.text')}</p>
      <p class="links">
        {feedbackLink && (
          <a class="text-link" href={feedbackLink}>
            {t('imprint.feedback.write')} →
          </a>
        )}
        <a class="text-link" href={`${SOURCE_REPO}/issues/new`} target="_blank" rel="noopener">
          {t('imprint.feedback.issue')} →
        </a>
      </p>
    </section>
  </article>
</BaseLayout>

<style>
  .imprint {
    max-width: 820px;
    padding-block: 28px 48px;
  }

  h1 {
    margin: 6px 0 10px;
    font-size: clamp(30px, 4vw, 44px);
  }

  .lead {
    margin: 0 0 22px;
    max-width: 64ch;
    color: var(--text-dim);
    font-size: 16px;
  }

  .block {
    margin-top: 12px;
    padding: 18px 22px;
    scroll-margin-top: 80px;
  }

  h2 {
    margin: 0 0 8px;
    font-size: 18px;
  }

  .block p {
    margin: 0 0 8px;
    max-width: 72ch;
    color: var(--text-dim);
    line-height: 1.6;
  }

  .block .links {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 24px;
  }

  .block .missing {
    color: var(--hot);
  }
</style>
