---
import { DEFAULT_LOCALE } from '../config/site';
import BaseLayout from '../layouts/BaseLayout.astro';
import { useTranslations } from '../lib/i18n';
import { localePath } from '../lib/links';

const locale = DEFAULT_LOCALE;
const { t } = useTranslations(locale);
---

<BaseLayout locale={locale} title={t('notFound.title')} description={t('notFound.text')}>
  <section class="container not-found">
    <p class="eyebrow mono">404</p>
    <h1>{t('notFound.title')}</h1>
    <p class="dim">{t('notFound.text')}</p>
    <a class="text-link" href={localePath(locale)}>
      {t('notFound.back')} →
    </a>
  </section>
</BaseLayout>

<style>
  .not-found {
    padding-block: 80px;
    text-align: center;
  }

  h1 {
    margin: 10px 0 12px;
    font-size: 40px;
  }
</style>
