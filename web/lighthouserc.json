{
  "ci": {
    "collect": {
      "staticDistDir": "./dist",
      "url": [
        "http://localhost/en/",
        "http://localhost/en/cards/",
        "http://localhost/en/rotation/",
        "http://localhost/en/search/",
        "http://localhost/de/",
        "http://localhost/de/cards/",
        "http://localhost/de/rotation/",
        "http://localhost/de/search/"
      ],
      "numberOfRuns": 1
    },
    "assert": {
      "assertions": {
        "categories:performance": ["warn", { "minScore": 0.8 }],
        "categories:accessibility": ["error", { "minScore": 0.95 }],
        "categories:best-practices": ["error", { "minScore": 0.9 }],
        "categories:seo": ["error", { "minScore": 0.9 }]
      }
    },
    "upload": {
      "target": "filesystem",
      "outputDir": "./lighthouse"
    }
  }
}
